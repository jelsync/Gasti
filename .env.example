# Copia este archivo como .env.local y completa con los valores de tu proyecto Supabase.
# NUNCA versiones el archivo .env / .env.local con valores reales.

# URL del proyecto Supabase (Settings -> API -> Project URL)
VITE_SUPABASE_URL=

# Clave pública "anon" del proyecto (Settings -> API -> Project API keys -> anon public)
VITE_SUPABASE_ANON_KEY=
